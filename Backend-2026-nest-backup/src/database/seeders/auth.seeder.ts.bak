import * as bcrypt from 'bcrypt';
import { UserModel, UserRole } from '../../features/auth/infrastructure/persistence/models/user.model';
import { RoleModel } from '../../features/auth/infrastructure/persistence/models/role.model';
import { ResourceModel } from '../../features/auth/infrastructure/persistence/models/resource.model';
import { RoleResourceModel } from '../../features/auth/infrastructure/persistence/models/role-resource.model';

type Recurso = [method: string, path: string, description: string, roles: UserRole[]];

const { ADMIN, BIBLIOTECARIO, LECTOR, INVITADO } = UserRole;
const TODOS = [ADMIN, BIBLIOTECARIO, LECTOR, INVITADO];
const AUTENTICADOS = [ADMIN, BIBLIOTECARIO, LECTOR];
const STAFF = [ADMIN, BIBLIOTECARIO];

const RECURSOS: Recurso[] = [
  ['GET', '/api/health', 'Estado del servicio', TODOS],
  ['GET', '/api/libros', 'Listar libros', TODOS],
  ['GET', '/api/libros/:id', 'Ver libro', TODOS],
  ['POST', '/api/libros', 'Crear libro', STAFF],
  ['PUT', '/api/libros/:id', 'Reemplazar libro', STAFF],
  ['PATCH', '/api/libros/:id', 'Actualizar libro', STAFF],
  ['DELETE', '/api/libros/:id', 'Eliminar libro', [ADMIN]],
  ['PATCH', '/api/libros/:id/deactivate', 'Desactivar libro', STAFF],
  ['GET', '/api/categorias', 'Listar categorías', TODOS],
  ['GET', '/api/categorias/:id', 'Ver categoría', TODOS],
  ['POST', '/api/categorias', 'Crear categoría', STAFF],
  ['PUT', '/api/categorias/:id', 'Reemplazar categoría', STAFF],
  ['PATCH', '/api/categorias/:id', 'Actualizar categoría', STAFF],
  ['DELETE', '/api/categorias/:id', 'Eliminar categoría', [ADMIN]],
  ['PATCH', '/api/categorias/:id/deactivate', 'Desactivar categoría', STAFF],
  ['GET', '/api/lectores/publico', 'Listado público de lectores', TODOS],
  ['GET', '/api/lectores/jwt', 'Listar lectores (JWT)', AUTENTICADOS],
  ['POST', '/api/lectores', 'Crear lector', [ADMIN]],
  ['GET', '/api/prestamos/estadisticas-publicas', 'Estadísticas públicas de préstamos', TODOS],
  ['GET', '/api/prestamos', 'Listar préstamos', AUTENTICADOS],
  ['POST', '/api/prestamos', 'Registrar préstamo', STAFF],
  ['GET', '/api/sesion/perfil', 'Perfil del usuario', AUTENTICADOS],
  ['GET', '/api/permisos', 'Permisos efectivos', AUTENTICADOS],
];

const USUARIOS = [
  { username: 'admin', nombre: 'Administrador', email: 'admin@lecturaabierta.com', password: 'Admin123!', rol: ADMIN },
  { username: 'biblio', nombre: 'Bibliotecario', email: 'biblio@lecturaabierta.com', password: 'Biblio123!', rol: BIBLIOTECARIO },
  { username: 'lector', nombre: 'Lector', email: 'lector@lecturaabierta.com', password: 'Lector123!', rol: LECTOR },
];

export async function seedAuth() {
  const roles = new Map<string, RoleModel>();
  for (const name of Object.values(UserRole)) {
    const [role] = await RoleModel.findOrCreate({ where: { name } });
    roles.set(name, role);
  }

  for (const [method, path, description, allowed] of RECURSOS) {
    const [resource] = await ResourceModel.findOrCreate({ where: { method, path }, defaults: { description } });
    for (const name of allowed) {
      await RoleResourceModel.findOrCreate({
        where: { role_id: roles.get(name)!.id, resource_id: resource.id },
      });
    }
  }

  for (const { password, ...data } of USUARIOS) {
    await UserModel.findOrCreate({
      where: { email: data.email },
      defaults: { ...data, password_hash: await bcrypt.hash(password, 10), is_active: true },
    });
  }
  console.log(`✅ Auth: ${roles.size} roles, ${RECURSOS.length} recursos, ${USUARIOS.length} usuarios`);
}
