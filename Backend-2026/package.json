{
  "name": "lecturaabierta-express",
  "version": "1.0.0",
  "description": "API REST de la Red de Bibliotecas LecturaAbierta (Express + Sequelize)",
  "main": "dist/server.js",
  "private": true,
  "license": "UNLICENSED",
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "dev": "npm run free:port && nodemon --watch src --ext ts --exec ts-node -- src/server.ts",
    "start:dev": "npm run dev",
    "start": "node dist/server.js",
    "free:port": "node scripts/free-port.js",
    "db:seed": "ts-node -- src/database/seeders/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "mysql2": "^3.24.5",
    "oracledb": "^7.0.1",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "sqlite3": "^6.0.1",
    "swagger-ui-express": "^5.0.1",
    "tedious": "^20.3.3"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.20.4",
    "@types/sequelize": "^6.12.0",
    "@types/swagger-ui-express": "^4.1.8",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.2"
  },
  "allowScripts": {
    "sqlite3@6.0.1": true,
    "oracledb@7.0.1": true
  }
}
