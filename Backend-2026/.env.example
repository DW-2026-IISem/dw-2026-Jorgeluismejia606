PORT=4000

# ── Interruptor de fases ──────────────────────────────────────────
# true  → Fase II: JWT + RBAC en todas las rutas.
# false → Fase I (laboratorio): las rutas de NEGOCIO quedan abiertas.
#         Se empareja con requireAuth del frontend (environment.ts).
AUTH_ENABLED=true

# ── JWT ───────────────────────────────────────────────────────────
JWT_SECRET=cambia-este-secreto
JWT_EXPIRES_IN=900
REFRESH_EXPIRES_IN=604800

# ── Motor de base de datos: sqlite | mysql | postgres | mssql | oracle
DB_ENGINE=sqlite
SQLITE_STORAGE=lectura_abierta.db

# Configuración para MySQL
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=password
MYSQL_NAME=lectura_abierta
MYSQL_PORT=3306

# Configuración para PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_NAME=lectura_abierta
POSTGRES_PORT=5432

# Configuración para SQL Server
MSSQL_HOST=localhost
MSSQL_USER=sa
MSSQL_PASSWORD=password
MSSQL_NAME=lectura_abierta
MSSQL_PORT=1433

# Configuración para Oracle
ORACLE_HOST=localhost
ORACLE_USER=LECTURA_ADMIN
ORACLE_PASSWORD=password
ORACLE_NAME=xe
ORACLE_PORT=1521
